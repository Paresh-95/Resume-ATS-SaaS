# --- Database (PostgreSQL) ---
# Paste your PostgreSQL connection string here, e.g.
# postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ats_resume_saas?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth (leave blank to disable Google sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- LLM provider (LangChain multi-vendor abstraction) ---
# Which vendor to use: "openai" | "anthropic"
MODEL_PROVIDER="anthropic"
MODEL_NAME="claude-sonnet-5"

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Price IDs for each paid plan (created in Stripe Dashboard)
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
